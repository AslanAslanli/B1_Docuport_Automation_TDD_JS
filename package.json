{
  "name": "b1_docuport_automation_tdd_js",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:all": "npx playwright test",
    "test:file": "npx playwright test --grep login-logout.spec.js",
    "test:tag": "npx playwright test -g @test12",
    "test:headed": "npx playwright test --headed",
    "test:beta": "cross-env TEST_ENV=beta npx playwright test --headed",
    "test:pre": "cross-env TEST_ENV=pre npx playwright test --headed",
    "test:firefox": "npx playwright test --project=firefox",
    "test:webkit": "cross-env TEST_ENV=beta npx playwright test -g @test12 --project=webkit --workers=1",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "test:smoke": "npx playwright test -g @smoke --project=chromium"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "cross-env": "^10.1.0"
  },
  "dependencies": {
    "dotenv": "^18.0.9"
  }
}
